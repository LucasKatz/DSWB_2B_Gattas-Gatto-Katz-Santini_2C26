# Copiar este archivo como .env (desarrollo local) y completar los valores.
# En Vercel: Project Settings > Environment Variables (mismos nombres).

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/kinevida

# Clave para firmar los tokens JWT (usar un valor largo y aleatorio)
JWT_SECRET=cambiar_por_una_clave_segura
